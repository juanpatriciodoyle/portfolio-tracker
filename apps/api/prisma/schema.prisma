datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

enum TransactionType {
  BOUGHT
  SOLD
  DEPOSIT
  WITHDRAWAL
}

enum FixedCostCategory {
  RENT
  ELECTRICITY
  GAS
  WATER
  HEATING_COOLING
  INTERNET
  PHONE
  SUBSCRIPTIONS
  TAXES
  OTHER
}

enum CostCadence {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUAL
}

enum BillingCadence {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUAL
  ONE_OFF
}

enum HousingTenure {
  RENT
  OWN
  FAMILY_OR_FREE
  OTHER
}

model User {
  id                  String          @id @default(uuid())
  userHash            String?         @unique
  email               String?         @unique
  name                String?
  avatarUrl           String?
  googleId            String?         @unique
  passkeyCredentialId String?         @unique
  passkeyPublicKey    String?
  passkeyCounter      Int             @default(0)
  cashBalance         Float           @default(0.0)
  country             String          @default("Spain")
  baseCurrency        String          @default("EUR")
  annualInflationRate Float           @default(2.8)
  positions           Position[]
  transactions        Transaction[]
  realizedGains       RealizedGain[]
  livingPhases        LivingPhase[]
  billingRecords      BillingRecord[]
  profile             UserProfile?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Position {
  id             String   @id @default(uuid())
  symbol         String   @default("CASH")
  name           String   @default("Cash")
  assetClass     String   @default("Cash")
  region         String   @default("Global")
  sector         String   @default("Financials")
  quantity       Float    @default(0.0)
  investedAmount Float    @default(0.0)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  symbol      String
  name        String?
  assetClass  String          @default("Stock")
  region      String          @default("Europe")
  sector      String          @default("Technology")
  quantity    Float           @default(1.0)
  amount      Float
  fee         Float           @default(0.0)
  totalAmount Float
  currency    String          @default("EUR")
  notes       String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
}

model RealizedGain {
  id                 String   @id @default(uuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol             String
  assetClass         String   @default("Stock")
  region             String   @default("Europe")
  sector             String   @default("Technology")
  investedAmount     Float
  returnedAmount     Float
  realizedPnl        Float
  realizedPnlPercent Float
  date               DateTime @default(now())
  createdAt          DateTime @default(now())
}

model InflationRate {
  id        String   @id @default(uuid())
  country   String
  year      Int
  rate      Float
  createdAt DateTime @default(now())

  @@unique([country, year])
}

/// A stretch of life in one home. Everything personal (name, city, address, income, notes) is
/// AES-256-GCM encrypted in `payload`; only what the database needs to order and join stays readable.
/// Ids are generated by the application because they are bound into the ciphertext.
model LivingPhase {
  id             String          @id
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  currency       String
  countryCode    String
  tenure         HousingTenure
  payload        String
  fixedCosts     FixedCostItem[]
  billingRecords BillingRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, startDate])
}

/// A bill actually received for a living phase (in that phase's currency). The vendor, amount and
/// notes are encrypted in `payload`; the period and category stay readable so ranges can be queried.
model BillingRecord {
  id          String            @id
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phaseId     String
  phase       LivingPhase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  category    FixedCostCategory
  cadence     BillingCadence
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  payload     String
  /// Keyed hash of phase, category, period, amount and sender: finds duplicates without storing anything readable.
  fingerprint String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, periodStart])
  @@index([phaseId])
}

/// A recurring bill of a living phase. `payload` (label, amount, notes) is encrypted.
model FixedCostItem {
  id        String            @id
  phaseId   String
  phase     LivingPhase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  category  FixedCostCategory
  cadence   CostCadence
  payload   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([phaseId])
}

/// One profile per user; the whole `payload` (name, birth year, nationalities...) is encrypted.
model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   String
  updatedAt DateTime @updatedAt
}

/// What public statistics offices publish about a country (income deciles, housing-cost share, PPP). Shared by everyone and
/// refreshed about monthly, so nothing here is personal and nothing is encrypted.
model CountryStatistics {
  countryCode String   @id
  payload     Json
  fetchedAt   DateTime
  updatedAt   DateTime @updatedAt
}
