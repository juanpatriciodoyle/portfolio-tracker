# Copy this file to `.env` (which is git-ignored) and adjust. Never commit real values.

# Matches docker-compose.yml. Prisma reads it for migrations and queries.
DATABASE_URL="postgresql://portfolio_user:portfolio_secure_password@localhost:5432/portfolio_tracker_db?schema=public"

# The API listens here; the Vite dev proxy (apps/web/vite.config.ts) expects 3000.
PORT=3000

JWT_SECRET=replace-with-a-long-random-string
USER_HASH_SALT=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=

# Field-level encryption (AES-256-GCM) of profile, living-phase and fixed-cost data.
# Exactly 32 random bytes, base64-encoded:   openssl rand -base64 32
# There is no default. Without it the profile routes answer 503 (and a production server will not start).
# Keep it safe and backed up: losing it makes the stored data unreadable.
PROFILE_ENCRYPTION_KEY=

# Optional: a disposable database for `npm run test:integration` (never your real data).
# TEST_DATABASE_URL="postgresql://portfolio_user:portfolio_secure_password@localhost:5432/portfolio_test?schema=public"
