# Copy to apps/api/.env (git ignores it) and fill in. In production the same names go in .env.production (see the repo root).

DATABASE_URL="postgresql://portfolio_user:CHANGE_ME@localhost:5432/portfolio_tracker_db?schema=public"
PORT=3000

# Signs sessions. Production needs at least 32 characters:  openssl rand -base64 48
JWT_SECRET=
# Keys the hash each account is stored under. Required, no default. Production needs at least 32 characters:
#   openssl rand -base64 48   Changing it later orphans every account.
USER_HASH_SALT=
# Encrypts stored data (32 random bytes as base64):  openssl rand -base64 32
# Without it, profile routes answer 503 in development, and the server will not start in production. Back it up.
PROFILE_ENCRYPTION_KEY=

# The Google OAuth client id. Without it every Google sign-in is refused (passkeys still work).
GOOGLE_CLIENT_ID=
# The administrator's email (sees the Analytics tab; signs in with Google only). Comma separated.
ADMIN_EMAILS=

# Passkeys: the domain and the exact address the browser shows. Development defaults to localhost / http://localhost:5173;
# production has no default and needs both.
# RP_ID=
# ORIGIN=

# false closes sign-up: only people who already have an account can sign in (the administrator can always create theirs).
# ALLOW_REGISTRATION=true
# The public "sneak peek" guest account. On in development, off in production unless set.
# ENABLE_DEMO=true
# How many reverse proxies stand in front of the API (0 for none).
# TRUST_PROXY=0
# off stops the daily refresh of country statistics.
# BENCHMARK_REFRESH=off

# A disposable database for `npm run test:integration`. NEVER the real one: the tests write to it.
# TEST_DATABASE_URL="postgresql://portfolio_user:CHANGE_ME@localhost:5432/portfolio_test?schema=public"
