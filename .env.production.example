# Copy to .env.production (git ignores it), fill every value, and keep the file readable only by you: chmod 600.
# Start the stack with:  docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# --- Database passwords. Use hex so no character needs escaping:  openssl rand -hex 24
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# --- Secrets
# Signs sessions. At least 32 characters:  openssl rand -base64 48
JWT_SECRET=
# Keys the hash of each email (accounts are stored under a hash, never an email). At least 32 characters:
#   openssl rand -base64 48   CHANGING IT LATER ORPHANS EVERY ACCOUNT: keep a copy somewhere safe.
USER_HASH_SALT=
# Encrypts the stored data. 32 random bytes as base64:  openssl rand -base64 32   LOSING IT MAKES THAT DATA UNREADABLE: keep a copy.
PROFILE_ENCRYPTION_KEY=

# --- Where the app lives. Passkeys and Google sign-in need this to be the real address people type.
# ORIGIN is the full address (https://...), RP_ID is its domain. (http://localhost is allowed only for testing.)
ORIGIN=
RP_ID=

# --- Sign-in
# The Google OAuth client id (public). Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# The administrator's email (sees the Analytics tab; signs in with Google only). Comma separated.
ADMIN_EMAILS=
# false closes sign-up: only people who already have an account can sign in.
ALLOW_REGISTRATION=true
# The public "sneak peek" guest account. Leave false in production.
ENABLE_DEMO=false

# --- Network
# How many reverse proxies stand between the internet and the API (the web container is one). Add one per extra proxy.
TRUST_PROXY=1
# Where the web container listens on this machine. 127.0.0.1 keeps it private; put whatever exposes it in front.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- Backups
# The PUBLIC key of an age key pair (starts with "age1"). Create the pair on ANOTHER machine:  age-keygen -o age.key
# and keep age.key (the private half) off this server, in a password manager and on paper.
BACKUP_AGE_PUBLIC_KEY=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
